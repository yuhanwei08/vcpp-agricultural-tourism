IDD_ZB DIALOG DISCARDABLE  0, 0, 241, 175
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bamboo Weaving"
FONT 9, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,47,150,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,146,150,50,14
    CONTROL         169,IDC_STATIC,"Static",SS_BITMAP,12,10,117,74
    LTEXT           "Bamboo symbolises integrity in Chinese culture. Traditional bamboo weaving reflects generations of skilled craft.",
                    IDC_STATIC,136,19,92,57
    LTEXT           "Artisans select and cut bamboo, split it into thin strips and smooth its edges. They weave these strips into useful and decorative objects by hand.",
                    IDC_STATIC,10,87,216,41
    LTEXT           "Their work preserves local memories and passes this traditional craft to future generations.",
                    IDC_STATIC,10,129,216,19
END

IDD_NJ DIALOG DISCARDABLE  0, 0, 220, 183
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Traditional Farm Tools"
FONT 9, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,40,158,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,128,158,50,14
    CONTROL         170,IDC_STATIC,"Static",SS_BITMAP,7,7,120,90
    LTEXT           "Traditional farm tools reflect the skill and labour of farming communities. Their practical designs connect visitors with agricultural history.",
                    IDC_STATIC,132,15,75,83
    LTEXT           "Farm tools support work throughout the year: preparing soil in spring, watering and weeding in summer, harvesting in autumn and preparing fields for the next season in winter.",
                    IDC_STATIC,12,101,198,58
END


